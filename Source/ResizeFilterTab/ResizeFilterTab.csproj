<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <_GamePath>/RimWorld</_GamePath>
    <_RootDir>../..</_RootDir>
    <PublishDir>$(_RootDir)/1.7/Assemblies</PublishDir>
    <_ModDir>$(_GamePath)/Mods/$(MSBuildProjectName)</_ModDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(_GamePath)/Mods/2009463077/1.7/Assemblies/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(_GamePath)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(_GamePath)/UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="PostPublish" AfterTargets="Publish">
    <MakeDir Directories="$(_ModDir)" />
    <ItemGroup>
      <AboutFiles Include="$(_RootDir)/About/**/*" />
      <Version13Files Include="$(_RootDir)/1.3/**/*" />
      <Version17Files Include="$(_RootDir)/1.7/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AboutFiles)" DestinationFolder="$(_ModDir)/About/%(RecursiveDir)" />
    <Copy SourceFiles="@(Version13Files)" DestinationFolder="$(_ModDir)/1.3/%(RecursiveDir)" />
    <Copy SourceFiles="@(Version17Files)" DestinationFolder="$(_ModDir)/1.7/%(RecursiveDir)" />
  </Target>

</Project>
